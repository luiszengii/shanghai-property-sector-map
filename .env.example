# 高德地图 JavaScript API 2.0 Web 端 Key
NEXT_PUBLIC_AMAP_KEY=

# 高德地图安全密钥（securityJsCode）
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

# 高德 Web 服务 Key（仅服务端，用于步行、骑行、公交通勤预计；不要加 NEXT_PUBLIC_ 前缀）
AMAP_WEB_SERVICE_KEY=

# 可选：GeoHUB 自定义地图样式 ID；也可填写完整 amap://styles/... 地址
NEXT_PUBLIC_AMAP_STYLE_ID=

# 可选：生产环境站点地址
NEXT_PUBLIC_SITE_URL=
