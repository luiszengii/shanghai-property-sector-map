{
  "name": "shanghai-property-sector-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/link-private-data.mjs",
    "dev": "next dev",
    "setup:local": "node scripts/setup-local-workspace.mjs",
    "check:local-setup": "node --test scripts/local-workspace-data.test.mjs",
    "build": "next build",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "next start",
    "check:editor": "node --test src/lib/sector-editor-drafts.test.ts src/lib/sector-editor-geometry-edit.test.ts src/lib/sector-editor-history.test.ts src/lib/sector-editor-versions.test.ts src/lib/sector-editor-version-store.test.ts src/lib/sector-editor-topology.test.ts src/lib/sector-editor-catalog.test.ts src/lib/sector-editor-layout.test.ts src/lib/sector-editor-map-options.test.ts",
    "check:map-performance": "node --test src/lib/project-marker-clustering.test.ts src/lib/sector-display-lod.test.ts src/lib/sector-label-visibility.test.ts",
    "check:public": "node scripts/check-public-surface.mjs",
    "verify:public": "node scripts/verify-public-deployment.mjs",
    "build:public-observations": "python3 scripts/build-public-observations.py",
    "build:public-project-data": "node scripts/build-public-project-data.mjs",
    "import:source-ledger-research-batch": "node scripts/import-source-ledger-research-batch.mjs",
    "check:public-project-data": "node scripts/build-public-project-data.mjs --check",
    "check:public-project-data-source": "node scripts/build-public-project-data.mjs --check --check-source",
    "check:sectors": "node scripts/check-sector-data.mjs",
    "perf:baseline": "node scripts/report-performance-baseline.mjs",
    "build:sector-client-index": "node scripts/build-sector-client-index.mjs",
    "build:private-sector-snapshots": "node scripts/build-private-sector-snapshots.mjs",
    "build:topology-repair-preview": "uv run --script scripts/build-project-topology-repair.py",
    "build:published-sector-topology": "uv run --script scripts/build-project-topology-repair.py --publish-approved-version topology-repair-production-2026-07-30 --publish-approved-at 2026-07-30T08:51:22+08:00",
    "check:sector-client-index": "node scripts/build-sector-client-index.mjs --check",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .private-data",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "^0.0.15",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
